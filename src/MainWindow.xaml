<Window x:Class="Android投屏助手.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="投屏助手"
        Icon="Assets/AppIcon.png"
        Width="520"
        Height="467"
        MinWidth="500"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Margin="0"
            Background="{DynamicResource WindowBrush}"
            BorderThickness="0"
            CornerRadius="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="84" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,0,24,0" Background="Transparent" PreviewMouseLeftButtonDown="Header_PreviewMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource HeaderIconBrush}" Margin="0,0,10,0">
                        <Image Source="Assets/AppIcon.png" Width="34" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="投屏助手" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WirelessButton" Click="WirelessButton_Click" Width="108" Height="36" Padding="8,0" Margin="0,0,7,0"
                            Background="{DynamicResource PanelStrongBrush}" BorderThickness="0"
                            ToolTip="选择无线连接方式" AutomationProperties.Name="无线连接">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="无线连接" FontSize="14" VerticalAlignment="Center" />
                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Margin="7,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="刷新" Click="Refresh_Click" Width="58" Height="36" Padding="0" Margin="0,0,4,0"
                            Background="{DynamicResource PanelStrongBrush}" BorderThickness="0" />
                    <Button Content="—" Width="28" Height="32" Padding="0" Margin="0" Click="Minimize_Click" Background="Transparent" BorderThickness="0" FontSize="16" />
                    <Button Content="×" Width="28" Height="32" Padding="0" Margin="0" Click="Close_Click" Background="Transparent" BorderThickness="0" FontSize="20" />
                </StackPanel>
            </Grid>

            <Popup x:Name="WirelessPopup" PlacementTarget="{Binding ElementName=WirelessButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="7">
                <Border Width="156" Padding="8" CornerRadius="16" Background="{DynamicResource PanelStrongBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Button Content="IP 直连" Click="AddWireless_Click" Height="38" Margin="0,0,0,3" Padding="12,0" HorizontalContentAlignment="Left" BorderThickness="0" />
                        <Button Content="配对码" Click="PairCode_Click" Height="38" Margin="0,0,0,3" Padding="12,0" HorizontalContentAlignment="Left" BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Popup>

            <Grid Grid.Row="1" Margin="24,13,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="设备" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Devices.Count}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text=" 台" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalAlignment="Center">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="1"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="2"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid>
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Columns" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Columns" Value="1" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="1"><Setter Property="Columns" Value="1" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                </UniformGrid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="166" Margin="0,0,7,8" Padding="17,12"
                                        Background="{DynamicResource PanelStrongBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource ConnectionOnlineBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding ConnectionStatusLabel}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ConnectionOnlineBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SystemLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="1" Content="开始投屏" Tag="{Binding}" Click="StartMirror_Click" Width="104" Height="36" Padding="0" Margin="0" Background="{DynamicResource AccentLightBrush}" BorderThickness="0"
                                                    IsEnabled="{Binding CanStartMirror}" Visibility="{Binding IsNotMirroring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Grid.Column="1" Content="结束投屏" Tag="{Binding}" Click="StopMirror_Click" Width="104" Height="36" Padding="0" Background="{DynamicResource StopButtonBrush}" BorderThickness="0" Margin="0"
                                                    Visibility="{Binding IsMirroring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <Border Height="166" Margin="0,0,7,8" Background="{DynamicResource PanelStrongBrush}" CornerRadius="18" Padding="16" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="等待连接手机" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="连接 USB 手机，或使用顶部的无线连接。"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" TextAlignment="Center" />
                    </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" FontSize="12" />
                <Button x:Name="ThemeButton" Grid.Column="1" Click="Theme_Click" Width="65" Height="32" Padding="0" Margin="0"
                        Style="{StaticResource BareIconButtonStyle}"
                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="切换颜色模式" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path x:Name="ThemeMoonIcon" Width="10" Height="10" Stretch="Uniform"
                              Data="M 20.985,12.486 A 9,9 0 1 1 11.514,3.015 C 11.919,2.993 12.131,3.475 11.916,3.817 A 6.5,6.5 0 0 0 20.186,12.087 C 20.528,11.872 21.01,12.083 20.985,12.486 Z"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,5,0" />
                        <Path x:Name="ThemeSunIcon" Width="10" Height="10" Stretch="Uniform"
                              Data="M 16,12 A 4,4 0 1 1 8,12 A 4,4 0 1 1 16,12 M 12,1 L 12,4 M 12,20 L 12,23 M 1,12 L 4,12 M 20,12 L 23,12 M 4.2,4.2 L 6.3,6.3 M 17.7,17.7 L 19.8,19.8 M 19.8,4.2 L 17.7,6.3 M 6.3,17.7 L 4.2,19.8"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.25"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ThemeLabel" Text="深色" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
