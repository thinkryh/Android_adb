<Window x:Class="Android投屏助手.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Android投屏助手"
        Icon="Assets/AppIcon.png"
        Width="560"
        Height="326"
        MinWidth="520"
        MinHeight="326"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Margin="0"
            Background="{DynamicResource WindowBrush}"
            BorderThickness="0"
            CornerRadius="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="12,8,12,0" Background="{DynamicResource PanelBrush}"
                    BorderThickness="0" CornerRadius="18" IsHitTestVisible="False" />
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource HeaderIconBrush}" Margin="0,0,10,0">
                        <Image Source="Assets/AppIcon.png" Width="34" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Android 投屏助手" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="刷新" Click="Refresh_Click" Height="32" Padding="12,0" Background="{DynamicResource PanelStrongBrush}" BorderThickness="0" />
                    <Button Content="—" Width="32" Height="32" Padding="0" Click="Minimize_Click" Background="Transparent" BorderThickness="0" FontSize="16" />
                    <Button Content="×" Width="32" Height="32" Padding="0" Click="Close_Click" Background="Transparent" BorderThickness="0" FontSize="20" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,2,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="无线连接" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <UniformGrid Grid.Column="1" Columns="4" Rows="1" VerticalAlignment="Center">
                        <Button Content="IP 直连" Click="AddWireless_Click" Height="34" Padding="0" Margin="0,0,5,0" Background="{DynamicResource AccentLightBrush}" BorderThickness="0" />
                        <Button Content="配对码" Click="PairCode_Click" Height="34" Padding="0" Margin="0,0,5,0" BorderThickness="0" />
                        <Button Content="扫码配对" Click="QrPair_Click" Height="34" Padding="0" Margin="0,0,5,0" BorderThickness="0" />
                        <Button Content="mDNS 发现" Click="Mdns_Click" Height="34" Padding="0" BorderThickness="0" />
                    </UniformGrid>
                </Grid>
                <Grid Grid.Row="1" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="设备" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Devices.Count}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text=" 台" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="1"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="2"><Setter Property="VerticalScrollBarVisibility" Value="Hidden" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid>
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Columns" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Columns" Value="1" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="1"><Setter Property="Columns" Value="1" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                </UniformGrid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="130" Margin="0,0,7,6" Padding="15,10"
                                        Background="{DynamicResource PanelStrongBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}" CornerRadius="10" Padding="8,4">
                                                <TextBlock Text="{Binding ConnectionLabel}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SystemLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Serial}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="开始投屏" Tag="{Binding}" Click="StartMirror_Click" Width="88" Height="32" Padding="0" Margin="0" Background="{DynamicResource AccentLightBrush}" BorderThickness="0"
                                                    IsEnabled="{Binding CanStartMirror}" Visibility="{Binding IsNotMirroring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Grid.Column="1" Content="结束" Tag="{Binding}" Click="StopMirror_Click" Width="88" Height="32" Padding="0" Background="{DynamicResource StopButtonBrush}" BorderThickness="0" Margin="0"
                                                    Visibility="{Binding IsMirroring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <Border Height="130" Margin="0,0,7,6" Background="{DynamicResource PanelStrongBrush}" CornerRadius="18" Padding="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="等待连接手机" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="连接 USB 后，在手机上允许调试。"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" TextAlignment="Center" />
                    </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="22,0,22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="浅色模式" Click="Theme_Click" Height="26" Padding="10,0" Margin="0,0,12,0" Background="{DynamicResource PanelStrongBrush}" BorderThickness="0" />
                    <TextBlock Text="v2 预览" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
