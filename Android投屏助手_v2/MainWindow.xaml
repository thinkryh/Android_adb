<Window x:Class="Android投屏助手.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Android投屏助手"
        Width="1050"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Margin="14"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="30,18,0,0">
                    <TextBlock Text="Android 投屏助手" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="USB 优先 · 无线备用 · 多设备管理" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="1,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="添加无线设备" Click="AddWireless_Click" Background="{StaticResource AccentLightBrush}" BorderThickness="0" />
                    <Button Content="刷新" Click="Refresh_Click" Background="{StaticResource PanelStrongBrush}" BorderThickness="0" />
                    <Button Content="—" Width="38" Padding="0" Click="Minimize_Click" Background="Transparent" BorderThickness="0" FontSize="16" />
                    <Button Content="×" Width="38" Padding="0" Click="Close_Click" Background="Transparent" BorderThickness="0" FontSize="20" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="28,4,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="设备" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="接入手机后会自动显示在这里；可同时管理多台设备。" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="扫码配对" Click="QrPair_Click" Background="{StaticResource PanelStrongBrush}" BorderThickness="0" />
                            <Button Content="配对码" Click="PairCode_Click" Background="{StaticResource PanelStrongBrush}" BorderThickness="0" />
                            <Button Content="mDNS 发现" Click="Mdns_Click" Background="{StaticResource PanelStrongBrush}" BorderThickness="0" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="305" MinHeight="190" Margin="0,0,16,16" Padding="18"
                                        Background="{StaticResource PanelStrongBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="22">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SystemLabel}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource AccentLightBrush}" CornerRadius="10" Padding="8,4">
                                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="11" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Serial}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="开始投屏" Tag="{Binding}" Click="StartMirror_Click" Background="{StaticResource AccentLightBrush}" BorderThickness="0" />
                                            <Button Content="结束" Tag="{Binding}" Click="StopMirror_Click" Background="#FFF0F1F3" BorderThickness="0" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="30,0,30,0">
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="v2 预览" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
