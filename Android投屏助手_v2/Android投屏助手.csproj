<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Android投屏助手</AssemblyName>
    <RootNamespace>Android投屏助手</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <ScrcpyFiles Include="..\scrcpy\**\*" />
    <Content Include="@(ScrcpyFiles)" LinkBase="scrcpy" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\发布包使用说明.md" Link="使用说明.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\third_party_licenses\**\*" LinkBase="third_party_licenses" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
